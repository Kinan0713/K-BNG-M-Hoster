# Copy this file to ".env" (same folder as the launcher) and paste your BeamMP Keymaster key.
# The launcher reads it automatically and injects it into ServerConfig.toml before startup.
# .env is git-ignored, so your key can never be pushed to GitHub.
#
# Optional alternative: set a Windows environment variable named BEAMMP_AUTHKEY.
# The environment variable takes priority over this file.
BEAMMP_AUTHKEY=YOUR_KEY_HERE
