# Skip nested duplicate extraction artifact
K BNG M Hoster V.0.2 - fix/

# Runtime folders
Backups/
Logs/
Quarantine/

# User's own webhook URL (never commit real URLs)
webhook.txt

# Local secrets (never commit your BeamMP AuthKey)
.env

# Runtime session artifacts
Server.log
CONNECTING.txt
staticip.cfg

# FRP tunnel runtime (contains the user's plaintext FRP token while running - never commit)
Server/frp_configs/
# Extracted frpc binary + extraction temporaries are ignored; the official FRP
# zip it ships with (Server/bin/frp_*.zip) stays tracked for the public build
Server/bin/frpc.exe
Server/bin/frpc.exe.tmp
Server/bin/frpc.exe.extract.lock

# Launcher artifacts (created when the launcher runs with the tool's working folder)
Launcher.cfg
Launcher.log
Resources/
Server.old.log

# User's own client mods (personal files - never commit)
Server/Resources/Client/*.zip

# Release zip (upload to GitHub Releases instead)
K.BNG.M.Hoster.v*.zip

# Mod export output (user-generated, often hundreds of MB - never commit)
Server/Export/

